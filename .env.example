# Copy to .env. The app reads it through node --env-file-if-exists.

# Level 2: traces and metrics go to Alloy over OTLP gRPC. Leave unset to run without telemetry.
ALLOY_GRPC_URL=http://localhost:4317

# Level 1: logs go to Alloy's Loki receiver.
ALLOY_LOGS_URL=http://localhost:4319

# Shown as the env label on logs and metrics.
NODE_ENV=development
